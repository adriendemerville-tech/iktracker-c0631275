{
  "version": 1,
  "sdk_version": "0.24.0",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://yarjaudctshlxkatqgeb.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "iktracker-mcp",
      "version": "0.1.0",
      "title": "IKtracker MCP"
    },
    "tools": [
      {
        "name": "list_vehicles",
        "title": "Lister mes véhicules",
        "description": "Retourne la liste des véhicules IKtracker de l'utilisateur (nom, marque, modèle, chevaux fiscaux, électrique, immatriculation).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_trips",
        "title": "Lister mes trajets",
        "description": "Retourne les trajets IKtracker de l'utilisateur, filtrables par plage de dates (YYYY-MM-DD) et par véhicule. Limite par défaut : 50, max 200.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "from": {
              "description": "Date de début incluse (YYYY-MM-DD).",
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "to": {
              "description": "Date de fin incluse (YYYY-MM-DD).",
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "vehicle_id": {
              "description": "Filtrer sur un véhicule.",
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "limit": {
              "description": "Nombre max de trajets (défaut 50).",
              "type": "integer",
              "minimum": 1,
              "maximum": 200
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "get_ytd_summary",
        "title": "Synthèse annuelle IK",
        "description": "Retourne le cumul kilométrique et l'indemnité totale par véhicule pour une année donnée (année en cours par défaut).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "year": {
              "description": "Année civile (défaut : année courante).",
              "type": "integer",
              "minimum": 2000,
              "maximum": 2100
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "create_trip",
        "title": "Créer un trajet",
        "description": "Crée un nouveau trajet IKtracker pour l'utilisateur. Le montant IK est laissé à zéro (recalculé côté app) ; renseigner un `ik_amount` explicite si besoin.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "date": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "Date du trajet (YYYY-MM-DD)."
            },
            "start_location": {
              "type": "string",
              "minLength": 1,
              "description": "Adresse ou nom du point de départ."
            },
            "end_location": {
              "type": "string",
              "minLength": 1,
              "description": "Adresse ou nom du point d'arrivée."
            },
            "distance": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Distance parcourue en kilomètres."
            },
            "vehicle_id": {
              "description": "Véhicule utilisé (UUID).",
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "round_trip": {
              "description": "Trajet aller-retour.",
              "type": "boolean"
            },
            "purpose": {
              "description": "Motif du déplacement.",
              "type": "string"
            },
            "ik_amount": {
              "description": "Montant IK en euros (0 par défaut).",
              "type": "number",
              "minimum": 0
            }
          },
          "required": [
            "date",
            "start_location",
            "end_location",
            "distance"
          ]
        },
        "outputSchema": null
      }
    ]
  }
}
