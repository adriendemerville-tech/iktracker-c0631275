{
  "version": 1,
  "sdk_version": "0.24.0",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://yarjaudctshlxkatqgeb.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "iktracker-mcp",
      "version": "0.1.0",
      "title": "IKtracker MCP"
    },
    "tools": [
      {
        "name": "list_vehicles",
        "title": "Lister mes véhicules",
        "description": "Retourne la liste des véhicules IKtracker de l'utilisateur (nom, marque, modèle, chevaux fiscaux, électrique, immatriculation).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_trips",
        "title": "Lister mes trajets",
        "description": "Retourne les trajets IKtracker de l'utilisateur, filtrables par plage de dates (YYYY-MM-DD) et par véhicule. Limite par défaut : 50, max 200.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "from": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "Date de début incluse (YYYY-MM-DD)."
            },
            "to": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "Date de fin incluse (YYYY-MM-DD)."
            },
            "vehicle_id": {
              "type": "string",
              "format": "uuid",
              "description": "Filtrer sur un véhicule."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "description": "Nombre max de trajets (défaut 50)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_ytd_summary",
        "title": "Synthèse annuelle IK",
        "description": "Retourne le cumul kilométrique et l'indemnité totale par véhicule pour une année donnée (année en cours par défaut).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "year": {
              "type": "integer",
              "minimum": 2000,
              "maximum": 2100,
              "description": "Année civile (défaut : année courante)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "create_trip",
        "title": "Créer un trajet",
        "description": "Crée un nouveau trajet IKtracker pour l'utilisateur. Le montant IK est laissé à zéro (recalculé côté app) ; renseigner un `ik_amount` explicite si besoin.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "date": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "Date du trajet (YYYY-MM-DD)."
            },
            "start_location": {
              "type": "string",
              "minLength": 1,
              "description": "Adresse ou nom du point de départ."
            },
            "end_location": {
              "type": "string",
              "minLength": 1,
              "description": "Adresse ou nom du point d'arrivée."
            },
            "distance": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Distance parcourue en kilomètres."
            },
            "vehicle_id": {
              "type": "string",
              "format": "uuid",
              "description": "Véhicule utilisé (UUID)."
            },
            "round_trip": {
              "type": "boolean",
              "description": "Trajet aller-retour."
            },
            "purpose": {
              "type": "string",
              "description": "Motif du déplacement."
            },
            "ik_amount": {
              "type": "number",
              "minimum": 0,
              "description": "Montant IK en euros (0 par défaut)."
            }
          },
          "required": [
            "date",
            "start_location",
            "end_location",
            "distance"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
